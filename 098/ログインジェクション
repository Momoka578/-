import java.io.*;
import java.util.logging.Logger;
import javax.servlet.*;
import javax.servlet.http.*;

public class Target98 extends HttpServlet
{
    public void doGet(HttpServletRequest req, HttpServletResponse res)
    	throws ServletException, IOException
    {
        res.setContentType("text/html");
        ServletOutputStream out = res.getOutputStream();
		Logger log = Logger.getLogger("Logforge");
        out.println("<HTML><HEAD><TITLE>Test</TITLE></HEAD><BODY><blockquote><pre>");

		String cmd = req.getParameter("cmd");
		if(cmd != null) {
			// 【修正】文字列を == で参照比較していたのを equals による内容比較に変更（CWE-597）
			if("valid".equals(cmd))
				out.println("good");
			else
				// 【修正】LF だけでなく、CR を含むすべての制御文字（\p{Cc}: U+0000-001F, U+007F-009F。U+0085 NEL を含む）と
				// 行区切り文字 U+2028（\p{Zl}）・段落区切り文字 U+2029（\p{Zp}）を "_" に置換し、偽のログ行を作れないようにする（CWE-117）
				log.info("invalid command: " + cmd.replaceAll("[\\p{Cc}\\p{Zl}\\p{Zp}]", "_"));
		} else {
			out.println("specify a command");
		}

        out.println("</pre></blockquote></BODY></HTML>");
        out.close();
    }
}
