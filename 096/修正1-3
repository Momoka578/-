const URL_CREDENTIALS_NO_SLASH = /(^|\s)((?!(?:[a-z]|npm|file):)[a-z0-9.+-]+:[/\\]*)[^\s/\\?#]*@/gi
function redactUrlCredentials (str, inSpec) {
  if (typeof str !== 'string') return str
  // 【修正3】spec 用は redactSpecCredentials で、先頭（またはパッケージ名の後）の URL を伏せてから、修正コード2 と同じ置き換えをする。
  if (inSpec) return redactSpecCredentials(str).replace(URL_CREDENTIALS_IN_SPEC, ':$1***@')
  return str.replace(URL_CREDENTIALS, ':$1***@').replace(URL_CREDENTIALS_NO_SLASH, '$1$2***@')
}
// 【修正3】npm-package-arg と同じ規則で、spec の中の URL の位置を決める。文字列がスキームで始まるときは全体が URL。
// そうでなければ、最初の「@」（@scope/ で始まるときは 2 番目の「@」）までがパッケージ名で、その後が URL になりうる
// （npa の Result の toString も name@saveSpec の形）。パッケージ名に「:」は使えないので、この 2 つで足りる。
function redactSpecCredentials (spec) {
  let start = 0
  if (!SPEC_STARTS_WITH_SCHEME.test(spec)) {
    const at = spec.indexOf('@', spec[0] === '@' ? 1 : 0)
    if (at !== -1) start = at + 1
  }
  return spec.slice(0, start) + spec.slice(start).replace(SPEC_URL_CREDENTIALS, '$1***@')
}

function andLogAndFinish (spec, tracker, done) {
  validate('SOF|SZF|OOF|OZF', [spec, tracker, done])
  return (er, pkg) => {
    if (er) {
      // 【修正】spec（npa の Result の toString を含む）と er.message を、認証情報を伏せてからログに出す。
