```javascript
'use strict'

// 【修正】新規に追加したファイル（置き場所: lib/utils/redact-url-auth.js）。
// ログやログファイルに書き出す文字列から、URL に含まれる認証情報（userinfo）を伏せる。
//   例: 'https://user:pass@example.com/pkg.tgz'
//    →  'https://***@example.com/pkg.tgz'
//   例: 'foo@git+https://user:token@github.com/owner/repo.git'
//    →  'foo@git+https://***@github.com/owner/repo.git'
// - エラーメッセージのように、文の途中に埋め込まれた URL も対象にするため、
//   url.parse で URL 全体を解析するのではなく、正規表現で置き換える。
// - `//` の直後から、次の `/` `?` `#` 空白文字の手前までの区間（URL の authority 部分）に
//   `@` があれば、その区間の最後の `@` までを userinfo とみなして `***` に置き換える。
//   パスワードに `@` がそのまま入っていても、最後の `@` まで伏せるので一部が残らない。
// - ユーザー名だけの形（https://TOKEN@github.com/... のようにトークンをユーザー名の位置に
//   入れる使い方がある）も伏せる。
// - 照合する区間は `/` を含まないため、照合は入力の長さに対して線形の時間で終わる。
// - 文字列以外（undefined など）は、そのまま返す（呼び出し元の表示を変えないため）。
const URL_USERINFO = /\/\/[^/?#\s]+@/g

module.exports = redactUrlAuth
function redactUrlAuth (str) {
  if (typeof str !== 'string') return str
  return str.replace(URL_USERINFO, '//***@')
}
