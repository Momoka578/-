      // これまでの er.message 用の置き換えを行う（順番を逆にすると、埋め込まれた spec の文字列と一致しなくなるため）。
      // String(spec) は 1 回だけ求めて、spec 側と redactSpecInMessage の両方で使う。
      const specString = String(spec)
      log.silly('fetchPackageMetaData', 'error for ' + redactUrlCredentials(specString, true), redactUrlCredentials(redactSpecInMessage(er.message, spec, specString)))
      if (tracker) tracker.finish()
    }
    return done(er, pkg)
  }
}

