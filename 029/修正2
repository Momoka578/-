### 副作用・残る点

- 動作の変化: 入れ子や連結を何段も重ね、途中の段ごとに大量の要素を作り直すパターンは、最後の結果が 100000 要素以内でも、累計の上限（1,000,000 個・128Mi 文字）を超えると RangeError になる。例えば `'{'×5 + '{1..50000}{,}' + '}'×5` や `'{1..1}'×9 + '{1..99999}'` は元の修正コードでは成功していたが、修正コード2 では例外になる。グロブのパターンとしては不自然な形で、通常の 1〜2 段の展開（`{1..100000}`、`{1..1000}{1..100}`、`{a,b}`×16 など）は従来どおり成功する。
- 例外の種類は元の修正コードと同じ RangeError で、メッセージは「too many expansions in total ... including intermediate results」と、1 回分の上限と区別できるようにした。
- 上限の値（10 倍・2 倍）は、正常な入力を通しつつ、悪意のある入力でも 1 回の呼び出しを 0.4 秒・百数十 MB 程度に抑えるための目安で、利用者が変えられる設定にはしていない（元の修正コードの上限も固定値のため）。
- 直していない点: L112 の `{a},b}` 処理の再帰（`'}'` が多い入力で再帰が深くなる）、parseCommaParts の再帰、依存先の balanced-match。どれも根拠の脆弱性とは別の箇所・別の原因で、実測でも 1 秒未満でスタック溢れの RangeError になって止まるため、元の修正コードと同じく対象外とした。
- 累計の数え方は、文字列の論理的な長さ（cons 文字列でも連結後の長さ）で数えているため、実際のメモリ使用量より多めに数える側になる（安全側）。

### 修正コード2 の全文: index.js

```javascript
var concatMap = require('concat-map');
var balanced = require('balanced-match');

module.exports = expandTop;

var escSlash = '\0SLASH'+Math.random()+'\0';
var escOpen = '\0OPEN'+Math.random()+'\0';
var escClose = '\0CLOSE'+Math.random()+'\0';
var escComma = '\0COMMA'+Math.random()+'\0';
var escPeriod = '\0PERIOD'+Math.random()+'\0';

// 【修正】展開結果の上限。連番展開（{1..100000000} など）や中かっこの組み合わせ（直積）で
// 巨大な配列・文字列が作られ、メモリと CPU を使い果たす DoS を防ぐ。
// 1 回の expand が作る要素数と合計文字数（中間結果を含む）がこれを超えたら例外を投げる。
var MAX_EXPANSIONS = 100000;
var MAX_TOTAL_LENGTH = 64 * 1024 * 1024;

// 【修正】上限の確認。超えた場合は途中で打ち切って黙って誤った結果を返すのではなく、例外にする
function checkLimit(count, length) {
  if (count > MAX_EXPANSIONS || length > MAX_TOTAL_LENGTH)
    throw new RangeError('brace-expansion: too many expansions (max ' +
      MAX_EXPANSIONS + ' items, ' + MAX_TOTAL_LENGTH + ' chars)');
}

// 【修正】配列内の文字列の合計文字数
function totalLength(arr) {
  var len = 0;
  for (var i = 0; i < arr.length; i++)
    len += arr[i].length;
  return len;
}

// 【修正2】上の MAX_EXPANSIONS・MAX_TOTAL_LENGTH は expand 1 回ごとの上限なので、
// 再帰（m.post の展開、入れ子の中かっこの展開し直し）の段を重ねると、段ごとに 10 万要素を
// 作り直せて CPU とメモリを使い果たせる（例: '{'×200 + '{1..50000}{,}' + '}'×200 で 80 秒以上、
// '{1..1}'×665 + '{1..99999}' で 2GB 以上）。そこで expandTop 1 回の呼び出し全体で
// 新しく作った文字列（中間結果を含む）の個数と合計文字数にも上限を設ける。
// 正常な入力でも中間結果の分だけ多く数えるので、1 回分の上限より大きめにしてある。
var MAX_TOTAL_ITEMS = 10 * MAX_EXPANSIONS;
var MAX_TOTAL_CHARS = 2 * MAX_TOTAL_LENGTH;

// 【修正2】今の expandTop 呼び出しで作った文字列の累計（expandTop の先頭で 0 に戻す）。
// 展開は同期処理で、途中で利用者のコードを呼ばないので、モジュール内の変数で数えてよい
var spentItems = 0;
var spentChars = 0;

// 【修正2】新しく作った文字列 count 個・合計 length 文字を累計に足し、上限を超えたら例外にする
function spend(count, length) {
  spentItems += count;
  spentChars += length;
  if (spentItems > MAX_TOTAL_ITEMS || spentChars > MAX_TOTAL_CHARS)
    throw new RangeError('brace-expansion: too many expansions in total (max ' +
      MAX_TOTAL_ITEMS + ' items, ' + MAX_TOTAL_CHARS +
      ' chars including intermediate results)');
}

function numeric(str) {
  return parseInt(str, 10) == str
    ? parseInt(str, 10)
    : str.charCodeAt(0);
}

function escapeBraces(str) {
  return str.split('\\\\').join(escSlash)
            .split('\\{').join(escOpen)
            .split('\\}').join(escClose)
            .split('\\,').join(escComma)
            .split('\\.').join(escPeriod);
}

function unescapeBraces(str) {
  return str.split(escSlash).join('\\')
            .split(escOpen).join('{')
            .split(escClose).join('}')
            .split(escComma).join(',')
            .split(escPeriod).join('.');
}


// Basically just str.split(","), but handling cases
// where we have nested braced sections, which should be
// treated as individual members, like {a,{b,c},d}
function parseCommaParts(str) {
  if (!str)
    return [''];

  var parts = [];
  var m = balanced('{', '}', str);

  if (!m)
    return str.split(',');

  var pre = m.pre;
  var body = m.body;
  var post = m.post;
  var p = pre.split(',');

  p[p.length-1] += '{' + body + '}';
  var postParts = parseCommaParts(post);
  if (post.length) {
    p[p.length-1] += postParts.shift();
    p.push.apply(p, postParts);
  }

  parts.push.apply(parts, p);

  return parts;
}

function expandTop(str) {
  if (!str)
    return [];

  // 【修正2】呼び出しごとに累計を 0 に戻す（前の呼び出しが例外で終わった場合も含む）
  spentItems = 0;
  spentChars = 0;

  // I don't know why Bash 4.3 does this, but it does.
  // Anything starting with {} will have the first two bytes preserved
  // but *only* at the top level, so {},a}b will not expand to anything,
  // but a{},b}c will be expanded to [a}c,abc].
  // One could argue that this is a bug in Bash, but since the goal of
  // this module is to match Bash's rules, we escape a leading {}
  if (str.substr(0, 2) === '{}') {
    str = '\\{\\}' + str.substr(2);
  }

  return expand(escapeBraces(str), true).map(unescapeBraces);
}

function identity(e) {
  return e;
}

function embrace(str) {
  return '{' + str + '}';
}
function isPadded(el) {
  return /^-?0\d/.test(el);
}

function lte(i, y) {
  return i <= y;
}
function gte(i, y) {
  return i >= y;
}

function expand(str, isTop) {
  var expansions = [];

  var m = balanced('{', '}', str);
  if (!m || /\$$/.test(m.pre)) return [str];

  var isNumericSequence = /^-?\d+\.\.-?\d+(?:\.\.-?\d+)?$/.test(m.body);
  var isAlphaSequence = /^[a-zA-Z]\.\.[a-zA-Z](?:\.\.-?\d+)?$/.test(m.body);
  var isSequence = isNumericSequence || isAlphaSequence;
  // 【修正】元の /^(.*,)+(.+)?$/ は量指定子の入れ子 (.*,)+ により、一致しない入力
  // （カンマの列の後に改行など）で指数時間のバックトラックを起こす（ReDoS）。
  // 元の正規表現が真になる条件は「カンマを 1 個以上含み、かつ '.' に一致しない
  // 行終端文字（\n \r \u2028 \u2029）を含まない」ことなので、同じ条件を線形時間の
  // 2 つの判定で調べる（判定結果は元と同じ）。
  var isOptions = m.body.indexOf(',') !== -1 &&
    !/[\n\r\u2028\u2029]/.test(m.body);
  if (!isSequence && !isOptions) {
    // {a},b}
    // 【修正】元の /,.*\}/ は '}' のないカンマの列などで O(n^2) のバックトラックになる。
    // 「カンマの後に行終端文字を挟まずに '}' がある」という同じ条件を、
    // カンマと '}' と行終端文字を除いた文字クラスで線形時間に調べる。
    if (m.post.match(/,[^,}\n\r\u2028\u2029]*\}/)) {
      str = m.pre + '{' + m.body + escClose + m.post;
      return expand(str);
    }
    return [str];
  }

  var n;
  if (isSequence) {
    n = m.body.split(/\.\./);
  } else {
    n = parseCommaParts(m.body);
    if (n.length === 1) {
      // x{{a,b}}y ==> x{a}y x{b}y
      n = expand(n[0], false).map(embrace);
      // 【修正2】embrace で作った文字列を累計に足す。これらは下の concatMap で 1 つずつ
      // expand し直されるので、入れ子を重ねると段ごとに作り直しになる
      spend(n.length, totalLength(n));
      if (n.length === 1) {
        var post = m.post.length
          ? expand(m.post, false)
          : [''];
        // 【修正】結果の要素数・合計文字数を確認してから返す
        var single = post.map(function(p) {
          return m.pre + n[0] + p;
        });
        // 【修正2】合計文字数は 1 回だけ数え、1 回分の上限と累計の上限の両方を確認する
        var singleLength = totalLength(single);
        checkLimit(single.length, singleLength);
        spend(single.length, singleLength);
        return single;
      }
    }
  }

  // at this point, n is the parts, and we know it's not a comma set
  // with a single entry.

  // no need to expand pre, since it is guaranteed to be free of brace-sets
  var pre = m.pre;
  var post = m.post.length
    ? expand(m.post, false)
    : [''];

  var N;

  if (isSequence) {
    var x = numeric(n[0]);
    var y = numeric(n[1]);
    var width = Math.max(n[0].length, n[1].length)
    var incr = n.length == 3
      ? Math.abs(numeric(n[2]))
      : 1;
    // 【修正】増分 0（{1..5..0} など）では i が進まず無限ループになり配列が際限なく
    // 大きくなるため、Bash と同じく 1 として扱う
    if (incr === 0)
      incr = 1;
    var test = lte;
    var reverse = y < x;
    if (reverse) {
      incr *= -1;
      test = gte;
    }
    var pad = n.some(isPadded);

    N = [];
    var seqLength = 0; // 【修正】連番の合計文字数

    for (var i = x; test(i, y); i += incr) {
      var c;
      if (isAlphaSequence) {
        c = String.fromCharCode(i);
        if (c === '\\')
          c = '';
      } else {
        c = String(i);
        if (pad) {
          var need = width - c.length;
          if (need > 0) {
            var z = new Array(need + 1).join('0');
            if (i < 0)
              c = '-' + z + c.slice(1);
            else
              c = z + c;
          }
        }
      }
      N.push(c);
      // 【修正】連番の個数と合計文字数（ゼロ埋めの長さを含む）が上限を超えたら中止する。
      // 2^53 を超える巨大な数値で i += incr が値を変えない場合の無限ループもここで止まる
      seqLength += c.length;
      checkLimit(N.length, seqLength);
      spend(1, c.length); // 【修正2】expandTop 全体の累計にも足す
    }
  } else {
    // 【修正】選択肢を 1 つ展開するたびに、それまでの合計の要素数・文字数を確認する
    var optCount = 0;
    var optLength = 0;
    N = concatMap(n, function(el) {
      var r = expand(el, false);
      optCount += r.length;
      optLength += totalLength(r);
      checkLimit(optCount, optLength);
      return r;
    });
  }

  // 【修正】直積（N × post）の組み合わせ数を先に確認する。トップレベルでは空文字列が
  // 結果から除かれるため、push の数だけでなくループの回数そのものを制限する
  checkLimit(N.length * post.length, 0);
  var outLength = 0; // 【修正】結果の合計文字数

  for (var j = 0; j < N.length; j++) {
    for (var k = 0; k < post.length; k++) {
      var expansion = pre + N[j] + post[k];
      if (!isTop || isSequence || expansion) {
        expansions.push(expansion);
        // 【修正】結果の合計文字数が上限を超えたら中止する
        outLength += expansion.length;
        checkLimit(expansions.length, outLength);
        spend(1, expansion.length); // 【修正2】expandTop 全体の累計にも足す
      }
    }
  }

  return expansions;
}
