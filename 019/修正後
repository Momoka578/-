## No.19 CVE-2018-16480 tnantoka/public bin/public（prePatch 6d152eb）

- 修正した脆弱性: パストラバーサル（CWE-22）
- 修正対象ファイル: bin/public（"修正版コード" No.19 の XSS 修正版をもとにした。このコードで XSS と CWE-22 の両方が直っている）
- 修正の内容:
  - `var root = path.resolve(dir);` の直後に、root の末尾に区切り文字を付けた rootPrefix を加えた。root が "/" のように最初から区切り文字で終わる場合は、二重に付けない。
  - アクセスの判定を `abs.indexOf(root) !== 0` から `abs !== root && abs.indexOf(rootPrefix) !== 0` に変えた。root と完全に一致するか、root＋区切り文字で始まるパスだけを許可する。
  - 防げること: root が /srv/pub のときの /srv/pub/../pub2/secret のように、同じ接頭辞を持つ兄弟ディレクトリのファイルを読む攻撃。
- 直さなかった点:
  - 公開ディレクトリ内のシンボリックリンクが外を指す場合（fs.realpath は使っていない）。判定で指摘したのはプレフィックス比較だけなので、最小限の修正にした（エージェントの判断）。
  - 判定の根拠で触れた「内部パスの開示」（エラー時に err の内容を表示する）は、判定の脆弱性の種類に入れていないので対象外にした。表示する内容は XSS の修正でエスケープされている。
  - エージェントは、機能上の不具合（今の Node では err.errno が負の値になるため 404 の分岐に入らない）にも気づいたが、安全には影響しないので直していない。
- 確認:
  - 親: XSS 修正版との差分が上の 2 か所（コメントを含む）だけであること、XSS の修正部分が変わっていないこと、node --check で構文エラーがないことを確認した。
  - エージェント（MARK END の後）: テスト用のディレクトリでサーバを起動して確かめた。/../pub2/secret.txt などの兄弟ディレクトリへのアクセスは、修正前は 200（読める）、修正後は 403 になった。通常のファイルとディレクトリ一覧は 200 のままだった。
  - 修正ファイルは、書き出した後に直していない。
- 使用トークン量（修正）: 新規 9,811（入力 4 ／ キャッシュ作成 6,127 ／ 出力〔推定〕 3,680）、キャッシュ読込 31,583、総処理 41,394、リクエスト 2 回

```javascript
#!/usr/bin/env node

/* Load modules */
var fs  = require('fs');
var path = require('path');
var url = require('url');
var http = require('http');
var mime = require('mime');

/* Load package.json */
var package = JSON.parse(fs.readFileSync(__dirname + '/../package.json'));

/* Define constants */
var VERSION = package.version;
var DEFAULT_DIR = '.';
var DEFAULT_PORT = 3000;

var USAGE = ''
  + 'Usage: publicjs [options] [dir="' + DEFAULT_DIR + '"] [port="' + DEFAULT_PORT + '"]\n'
  + '\n'
  + 'Options:\n'
  + '\t-v, --version\tShow version number\n'
  + '\t-h, --help\tShow this help message\n'
;

/* Define functions */

// Successful end
function success(msg) {
  console.log(msg);
  process.exit(0);
}

// Abnormal end
function error(msg) {
  console.error(msg);
  process.exit(1);
}

// 修正: HTML に埋め込む文字列をエスケープする関数を追加
// （& < > " ' を文字参照に変換し、タグや属性として解釈されないようにする）
function escapeHtml(str) {
  if (str === undefined || str === null) {
    return ''; // join() と同じく undefined/null は空文字として扱う
  }
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/* Parse arguments */
var args = process.argv.slice(2);
var dir = DEFAULT_DIR;
var port = DEFAULT_PORT;
switch (args[0]) {
  case '-h':
  case '--help':
    success(USAGE);
    break;
  case '-v':
  case '--version':
    success(VERSION);
    break;
  default:
    // publicjs dir port
    if (args.length >= 2) {
      dir = args[0];
      if (isFinite(args[1])) {
        port = args[1];
      }
    } else if (args.length == 1) {
      // publicjs port
      if (isFinite(args[0])) {
        port = args[0];
      // publicjs dir
      } else {
        dir = args[0];
      }
    }
}
var root = path.resolve(dir);
// 【修正】公開ルートの末尾に区切り文字を付けた接頭辞を用意する
// （root が "/" や "C:\" のように既に区切り文字で終わる場合は二重に付けない）
var rootPrefix = root.slice(-1) === path.sep ? root : root + path.sep;

if (path) {
  http.createServer(function(req, res) {
    var pathname = url.parse(req.url).pathname;
    var filePath = path.join(dir, pathname); // Real file path
    var base = filePath.replace(dir, ''); // Base path for browser link
    var abs = path.resolve(filePath);
    console.log(new Date().toString(), abs);

    // 【修正】区切り文字なしの前方一致（abs.indexOf(root) !== 0）では、root が /srv/pub のとき
    // /srv/pub/../pub2/secret（= /srv/pub2/secret）も通ってしまうため、
    // 「root と完全に一致する」か「root + 区切り文字 で始まる」場合だけ許可する
    if (abs !== root && abs.indexOf(rootPrefix) !== 0) {
      res.writeHead(403, { 'Content-Type': 'text/plain' });
      res.end('Forbidden\n');
      return;
    }

    fs.readFile(filePath, function(err, data) {
      if (err) {
        res.writeHead(200, { 'Content-Type': 'text/html' });
        // Index files if 404 or directory
        if ([2, 21, 28, -1, -21].indexOf(err.errno) < 0) {
          // 修正: エラー内容（パスを含む）をエスケープしてから出力
          res.write(['<h1>', escapeHtml(res.message), '</h1>'].join(''));
          res.end(['<pre>', escapeHtml(JSON.stringify(err, null, '  ')), '</pre>'].join(''));
          return;
        } else {
          if (err.errno == 2) { // 404
            filePath = path.dirname(filePath);
          }
          fs.readdir(filePath, function(err, files) {
            if (err) {
              // 修正: エラー内容（パスを含む）をエスケープしてから出力
              res.write(['<h1>', escapeHtml(res.message), '</h1>'].join(''));
              res.end(['<pre>', escapeHtml(JSON.stringify(err, null, '  ')), '</pre>'].join(''));
              return;
            }
            var list = ['<ul>'];
            files.unshift('..');
            files.forEach(function(file) {
              // 修正: ファイル名を href 属性と要素内容に埋め込む前に HTML エスケープする
              list.push('<li><a href="', escapeHtml(path.join(base, file)),'">', escapeHtml(file), '</a></li>');
            });
            list.push('</ul>');
            // 修正: リクエストパスから作った abs も HTML エスケープしてから出力
            res.write(['<h1>', 'Index of "', escapeHtml(abs), '"</h1>'].join(''));
            res.end(list.join('\n'));
          });
        }
        return;
      }
      res.writeHead(200, { 'Content-Type': mime.lookup(filePath) });
      res.end(data);
    });
  }).listen(port, function() {
    console.log('Public.js server running with "' + path.resolve(dir) + '" on port ' + port);
  });
} else {
  error(USAGE);
}
