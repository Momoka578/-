### 副作用・残る点

- 動作の変化:
  - "/" で始まらない href の先頭に `./` が付く（HTML のソース上の変化）。解決されるリンク先は、修正前に http: の URL になっていたものについては変わらない（上の確認 5・6）。
  - 修正前は、dir を末尾スラッシュ付きで指定したときのルートの一覧で、`a:b.txt` のように ":" を含む名前のファイルのリンクが `a:` というスキームの URL と解釈されて開けなかったが、修正コード2 では `http://ホスト/a:b.txt` になり開けるようになる（改善の方向の変化）。
- 直していない点とその理由:
  - 既定の dir "." のとき、サブディレクトリの一覧のリンクが `sub/a.txt` のような相対パスになり、`/sub/sub/a.txt` を指してしまう不具合（元のコードの `filePath.replace(dir, '')` による base の作り方が原因）。安全には関係しない機能上の不具合で、直すとリンク先が変わるため、最小限の修正の範囲外とした。`./` を付けてもこの解決先は変わらない。
  - `filePath.replace(dir, '')` が最初に一致した部分を消す作り（既定の "." では名前の最初の "." が消える、など）も同じ理由で直していない。
  - 名前に `#`、`?`、`%`、空白、日本語などを含むファイルのリンクが開けないことがある（サーバ側で pathname をデコードしないため）。元からの機能上の不具合で、安全には関係しないので直していない。
  - 元の修正コードで対象外とした点（公開ディレクトリ内のシンボリックリンクが外を指す場合、エラー時に err の内容＝内部パスを表示すること、今の Node では errno が負の値になり 404 の分岐に入らないこと）は、判定の脆弱性の修正が成り立つことに影響しないので、そのままにした。
  - 公開ディレクトリに置かれた .html や .svg のファイルは、そのまま text/html などで配信される。静的ファイルサーバとしての仕様で、判定の対象（一覧ページのファイル名の扱い）とは別なので対象外とした。
  - Windows 環境での動作（path.sep が "\" の場合）は、この環境では実行できないため、コードを読んで確かめた（"\" で始まる href は、ブラウザが http の URL で "\" を "/" と同じに扱うので、そのまま絶対パスとして扱い、`./` を付けない）。

### 修正コード2 の全文: bin/public

```javascript
#!/usr/bin/env node

/* Load modules */
var fs  = require('fs');
var path = require('path');
var url = require('url');
var http = require('http');
var mime = require('mime');

/* Load package.json */
var package = JSON.parse(fs.readFileSync(__dirname + '/../package.json'));

/* Define constants */
var VERSION = package.version;
var DEFAULT_DIR = '.';
var DEFAULT_PORT = 3000;

var USAGE = ''
  + 'Usage: publicjs [options] [dir="' + DEFAULT_DIR + '"] [port="' + DEFAULT_PORT + '"]\n'
  + '\n'
  + 'Options:\n'
  + '\t-v, --version\tShow version number\n'
  + '\t-h, --help\tShow this help message\n'
;

/* Define functions */

// Successful end
function success(msg) {
  console.log(msg);
  process.exit(0);
}

// Abnormal end
function error(msg) {
  console.error(msg);
  process.exit(1);
}

// 修正: HTML に埋め込む文字列をエスケープする関数を追加
// （& < > " ' を文字参照に変換し、タグや属性として解釈されないようにする）
function escapeHtml(str) {
  if (str === undefined || str === null) {
    return ''; // join() と同じく undefined/null は空文字として扱う
  }
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/* Parse arguments */
var args = process.argv.slice(2);
var dir = DEFAULT_DIR;
var port = DEFAULT_PORT;
switch (args[0]) {
  case '-h':
  case '--help':
    success(USAGE);
    break;
  case '-v':
  case '--version':
    success(VERSION);
    break;
  default:
    // publicjs dir port
    if (args.length >= 2) {
      dir = args[0];
      if (isFinite(args[1])) {
        port = args[1];
      }
    } else if (args.length == 1) {
      // publicjs port
      if (isFinite(args[0])) {
        port = args[0];
      // publicjs dir
      } else {
        dir = args[0];
      }
    }
}
var root = path.resolve(dir);
// 【修正】公開ルートの末尾に区切り文字を付けた接頭辞を用意する
// （root が "/" や "C:\" のように既に区切り文字で終わる場合は二重に付けない）
var rootPrefix = root.slice(-1) === path.sep ? root : root + path.sep;

if (path) {
  http.createServer(function(req, res) {
    var pathname = url.parse(req.url).pathname;
    var filePath = path.join(dir, pathname); // Real file path
    var base = filePath.replace(dir, ''); // Base path for browser link
    var abs = path.resolve(filePath);
    console.log(new Date().toString(), abs);

    // 【修正】区切り文字なしの前方一致（abs.indexOf(root) !== 0）では、root が /srv/pub のとき
    // /srv/pub/../pub2/secret（= /srv/pub2/secret）も通ってしまうため、
    // 「root と完全に一致する」か「root + 区切り文字 で始まる」場合だけ許可する
    if (abs !== root && abs.indexOf(rootPrefix) !== 0) {
      res.writeHead(403, { 'Content-Type': 'text/plain' });
      res.end('Forbidden\n');
      return;
    }

    fs.readFile(filePath, function(err, data) {
      if (err) {
        res.writeHead(200, { 'Content-Type': 'text/html' });
        // Index files if 404 or directory
        if ([2, 21, 28, -1, -21].indexOf(err.errno) < 0) {
          // 修正: エラー内容（パスを含む）をエスケープしてから出力
          res.write(['<h1>', escapeHtml(res.message), '</h1>'].join(''));
          res.end(['<pre>', escapeHtml(JSON.stringify(err, null, '  ')), '</pre>'].join(''));
          return;
        } else {
          if (err.errno == 2) { // 404
            filePath = path.dirname(filePath);
          }
          fs.readdir(filePath, function(err, files) {
            if (err) {
              // 修正: エラー内容（パスを含む）をエスケープしてから出力
              res.write(['<h1>', escapeHtml(res.message), '</h1>'].join(''));
              res.end(['<pre>', escapeHtml(JSON.stringify(err, null, '  ')), '</pre>'].join(''));
              return;
            }
            var list = ['<ul>'];
            files.unshift('..');
            files.forEach(function(file) {
              // 【修正2】リンク先が "/"（Windows では "\" も）で始まらない相対パスのときは、先頭に "./" を付ける。
              // dir を末尾スラッシュ付きで指定したとき（"pub/" "./" "/" など）のルートの一覧では base が空になり、
              // 既定の dir "." のときのサブディレクトリの一覧では base が "サブディレクトリ名/" になるため、
              // href がファイル名・ディレクトリ名そのものから始まる。HTML エスケープだけでは、
              // "javascript:alert(1)" という名前のファイルを置かれると、href がスキーム付きの URL として解釈され、
              // クリックで JavaScript が実行された。"./" で始まる値はスキームとして解釈されない
              // （スキームは英字で始まる必要がある）ので、これを防げる。相対 URL の "./x" は "x" と同じ場所を指すので、
              // リンク先は変わらない。
              var href = path.join(base, file);
              if (href.charAt(0) !== '/' && href.charAt(0) !== '\\') {
                href = './' + href;
              }
              // 修正: ファイル名を href 属性と要素内容に埋め込む前に HTML エスケープする
              list.push('<li><a href="', escapeHtml(href),'">', escapeHtml(file), '</a></li>');
            });
            list.push('</ul>');
            // 修正: リクエストパスから作った abs も HTML エスケープしてから出力
            res.write(['<h1>', 'Index of "', escapeHtml(abs), '"</h1>'].join(''));
            res.end(list.join('\n'));
          });
        }
        return;
      }
      res.writeHead(200, { 'Content-Type': mime.lookup(filePath) });
      res.end(data);
    });
  }).listen(port, function() {
    console.log('Public.js server running with "' + path.resolve(dir) + '" on port ' + port);
  });
} else {
  error(USAGE);
}
