### 副作用・残る点

- 動作の変化:
  - allowPrivateNetwork が true でないとき、子ターゲット（OOPIF・Worker）の通信も待ち合わせの対象（outstandingRequests）に入る。試験では、cross-site iframe や Worker を含むページで、元のコードが 10 秒の上限まで待っていた描画が早く終わった（/xsite 10 秒 → 約 0.1〜0.4 秒）。返す内容は同じだった。
  - 公開ページの中の OOPIF・Worker・WebSocket が内部アドレスに接続すると、ページ全体の描画が 400 になる（内容を返さない）。元の修正コードの、トップレベルの方針と同じ。
  - WebSocket のホスト名が DNS で引けないときも、内部と同じ扱いで 400 になる（判定できない値は拒否する方針）。
- chrome-remote-interface の版: 修正コード2 は、子のセッションに `client.send(method, params, sessionId)` でコマンドを送る。このため、sessionId（flatten 方式）を扱える版の chrome-remote-interface が要る（試験では 0.34.0）。package.json の依存 `^0.24.1` の版は sessionId を扱えない。ただし 0.24 は、Chrome 111 以降が要求する PUT /json/new に対応しないので、そもそも新しい Chrome には接続できない。また、0.24 で使える古いヘッドレスの Chrome では、cross-site の iframe は通常同じプロセスで動き、元の修正コードの検査が効く。sessionId を無視する古い版を模擬した試験（DROP_SESSION）では、子ターゲットが一時停止のまま残った。このため、iframe の中身や Worker が動かず、内容は漏れなかった。一方で /screenshot が返らない（40 秒でタイムアウト）ことがあった。この組み合わせ（古い chrome-remote-interface と、サイト分離された Chrome）では使わない前提になる。
- 直していない点とその理由:
  - DNS リバインディング:
    - WebSocket の検査は、Node 側の DNS の答えで行う。Chrome が別の答え（内部アドレス）を得た場合は見逃しうる。HTTP の応答は実際の接続先 IP で検査するので、そちらは捕まえられる。
    - リバインディングなどでページの JavaScript が内部の内容を読み、攻撃者のサーバへ直接送る経路は、元の修正コードの説明どおり、この方式では防げない。完全に防ぐには、Chrome の全通信を、接続先 IP を検査するプロキシに通す、あるいはネットワーク側で内部への通信を遮断するなど、構成上の対策が要る。
  - 内部への通信そのもの: 子ターゲットや WebSocket で内部への接続が起きたことは検出して内容を返さないが、接続（リクエストの送信）そのものは止められない。元の修正コードの「残る点」と同じ。
  - HTTP・WebSocket 以外の経路は対象外とした。WebRTC など、CDP の Network イベントに現れない経路で、ページから内部と通信する方法がこれにあたる。
  - タブが残る: 検査で reject したとき、タブと CDP 接続を閉じないまま残る。元のコードの loadingFailed の経路と同じ、既存の作りのままにした。
  - 補足の XSS（main.js の `Cannot render ${url}` を text/html で返す）、`/_ah/stop` に認証がない点、renderOnly の前方一致は、元の修正コードと同じく対象外（CWE-200 の修正とは原因が別で、その成否に影響しない）。

### 修正コード2 の全文: src/renderer.js

```javascript
'use strict';

const CDP = require('chrome-remote-interface');
// 【修正】URL の検査（スキームと接続先アドレス）に使うモジュール
const dns = require('dns');
const net = require('net');
const {URL} = require('url');

// 【修正】レンダリングを許可する URL スキーム（file:, chrome:, data:, view-source: などは拒否する）
const ALLOWED_PROTOCOLS = ['http:', 'https:'];

// 【修正】内部アドレスへの接続を拒否したときのエラーメッセージ（利用者の入力は含めない）
const PRIVATE_ADDRESS_MESSAGE = 'Access to private network address is forbidden';

// 【修正2】子ターゲット（別プロセスの iframe や Worker）の通信を監視できなかったときのエラーメッセージ
const UNMONITORED_TARGET_MESSAGE = 'Cannot monitor network access of a subframe or worker';

// 【修正2】子ターゲットへの自動アタッチの設定。flatten 方式で、子ターゲットは起動直後に一時停止させる
// （Network を有効にしてから動かすため、最初の通信から検査できる）
const AUTO_ATTACH_PARAMS = {autoAttach: true, waitForDebuggerOnStart: true, flatten: true};

/**
 * 【修正】IPv4 アドレス（4 つの数値）が内部向け・予約済みの範囲か判定する。
 * @param {!Array<number>} p
 * @return {boolean}
 */
function isPrivateIPv4(p) {
  return p[0] === 0 || p[0] === 10 || p[0] === 127 ||   // 0.0.0.0/8, 10.0.0.0/8, ループバック
      (p[0] === 100 && p[1] >= 64 && p[1] <= 127) ||    // 100.64.0.0/10（CGN）
      (p[0] === 169 && p[1] === 254) ||                 // リンクローカル（クラウドのメタデータサーバ）
      (p[0] === 172 && p[1] >= 16 && p[1] <= 31) ||     // 172.16.0.0/12
      (p[0] === 192 && p[1] === 168) ||                 // 192.168.0.0/16
      (p[0] === 192 && p[1] === 0 && p[2] === 0) ||     // 192.0.0.0/24
      (p[0] === 198 && (p[1] === 18 || p[1] === 19)) || // 198.18.0.0/15
      p[0] >= 224;                                      // マルチキャスト・予約・ブロードキャスト
}

/**
 * 【修正】IP アドレスがループバック・プライベート・リンクローカルなど、
 * 外部の利用者に接続させてはならない範囲か判定する。判定できない値は true（拒否）とする。
 * @param {string} address
 * @return {boolean}
 */
function isPrivateAddress(address) {
  const ip = String(address).replace(/^\[|\]$/g, '').replace(/%.*$/, '').toLowerCase();
  if (net.isIPv4(ip))
    return isPrivateIPv4(ip.split('.').map(Number));
  if (!net.isIPv6(ip))
    return true;

  // IPv6 を 16 ビット × 8 個に展開する（末尾が IPv4 表記なら 16 進 2 個に変換する）。
  let s = ip;
  const v4 = s.match(/(\d+)\.(\d+)\.(\d+)\.(\d+)$/);
  if (v4)
    s = s.slice(0, v4.index) + ((v4[1] << 8) | v4[2]).toString(16) + ':' + ((v4[3] << 8) | v4[4]).toString(16);
  const halves = s.split('::');
  const head = halves[0] ? halves[0].split(':') : [];
  const tail = halves[1] ? halves[1].split(':') : [];
  const groups = halves.length === 2 ?
      head.concat(new Array(Math.max(0, 8 - head.length - tail.length)).fill('0'), tail) : head;
  if (groups.length !== 8)
    return true;
  const w = groups.map((g) => parseInt(g, 16));
  const embedded = [w[6] >> 8, w[6] & 0xff, w[7] >> 8, w[7] & 0xff];

  if (w[0] === 0 && w[1] === 0 && w[2] === 0 && w[3] === 0 && w[4] === 0 && (w[5] === 0 || w[5] === 0xffff))
    return isPrivateIPv4(embedded);   // ::, ::1, IPv4 互換アドレス, IPv4 射影アドレス（::ffff:127.0.0.1 など）
  if (w[0] === 0x64 && w[1] === 0xff9b)
    return isPrivateIPv4(embedded);   // NAT64（64:ff9b::/96）
  if (w[0] === 0x2002)
    return isPrivateIPv4([w[1] >> 8, w[1] & 0xff, w[2] >> 8, w[2] & 0xff]);  // 6to4（2002::/16）
  return (w[0] & 0xfe00) === 0xfc00 ||  // ユニークローカル fc00::/7
      (w[0] & 0xffc0) === 0xfe80 ||     // リンクローカル fe80::/10
      (w[0] & 0xffc0) === 0xfec0 ||     // サイトローカル fec0::/10（廃止済み）
      (w[0] & 0xff00) === 0xff00;       // マルチキャスト ff00::/8
}

/**
 * 【修正】利用者が指定した URL を検査し、正規化した URL を返す。
 * http:/https: 以外のスキーム（file: など）と、内部ネットワークのアドレスに
 * 解決されるホスト（localhost, 127.0.0.1, 169.254.169.254 など）は拒否する。
 * config.allowPrivateNetwork が true のときだけ内部アドレスを許可する（テスト・社内利用向け）。
 * @param {string} url
 * @param {!Object} config
 * @return {!Promise<string>}
 */
async function validateUrl(url, config) {
  let parsed;
  try {
    parsed = new URL(url);
  } catch (e) {
    throw new Error('Invalid URL');
  }
  if (!ALLOWED_PROTOCOLS.includes(parsed.protocol))
    throw new Error('URL scheme is not allowed');

  if (!config['allowPrivateNetwork']) {
    const hostname = parsed.hostname.replace(/^\[|\]$/g, '');
    const addresses = await new Promise((resolve, reject) => {
      dns.lookup(hostname, {all: true}, (err, result) => {
        if (err)
          reject(new Error('Cannot resolve host'));
        else
          resolve(result);
      });
    });
    if (!addresses.length || addresses.some((a) => isPrivateAddress(a.address)))
      throw new Error(PRIVATE_ADDRESS_MESSAGE);
  }
  return parsed.href;
}

/**
 * 【修正2】ページが開いた WebSocket の接続先が内部アドレスか判定する。
 * WebSocket の CDP イベントには接続先の IP（remoteIPAddress）が無いため、URL のホストを
 * 自分で検査する。IP アドレスならそのまま判定し、ホスト名なら DNS で引いて 1 つでも内部
 * アドレスがあれば true とする。URL が解析できない・名前が解決できない場合も true（拒否）とする。
 * @param {string} url
 * @return {!Promise<boolean>}
 */
async function isPrivateWebSocketUrl(url) {
  let hostname;
  try {
    hostname = new URL(url).hostname.replace(/^\[|\]$/g, '');
  } catch (e) {
    return true;
  }
  if (net.isIP(hostname))
    return isPrivateAddress(hostname);
  return new Promise((resolve) => {
    dns.lookup(hostname, {all: true}, (err, result) => {
      resolve(!!err || !result.length || result.some((a) => isPrivateAddress(a.address)));
    });
  });
}

class Renderer {
  _loadPage(client, url, options, config) {
    /**
     * Finds any meta tags setting the status code.
     * @return {?number} status code
     */
    function getStatusCode() {
      const metaElement = document.querySelector('meta[name="render:status_code"]');
      if (!metaElement)
        return undefined;
      return parseInt(metaElement.getAttribute('content')) || undefined;
    }

    /**
     * Listens for the 'render-complete' event.
     */
    function listenForCompletionEvent() {
      document.addEventListener('render-complete', () => {
        console.log('Rendering complete');
      });
    }

    return new Promise(async(resolve, reject) => {
      // 【修正2】子ターゲットの監視に Target ドメインを使う
      const {Page, Runtime, Network, Emulation, Console, Target} = client;

      await Promise.all([
        Page.enable(),
        Runtime.enable(),
        Console.enable(),
        Network.enable(),
        Network.setBypassServiceWorker({bypass: true}),
      ]);

      // Inject the Shady DOM polyfill if web components v1 is used, so we can
      // serialize the page.
      // TODO(samli): This needs to change to use the non-deprecated API after Chrome 61
      //   addScriptToEvaluateOnNewDocument({source: `ShadyDOM = {force: true}`})
      const shadyFlag = options['wc-inject-shadydom'];
      if (shadyFlag == '' || !!shadyFlag) {
        // Deprecated in Chrome 61.
        Page.addScriptToEvaluateOnLoad({scriptSource: `customElements.forcePolyfill = true`});
        Page.addScriptToEvaluateOnLoad({scriptSource: `ShadyDOM = {force: true}`});
        Page.addScriptToEvaluateOnLoad({scriptSource: `ShadyCSS = {shimcssproperties: true}`});
      }

      // Add hook for completion event.
      Page.addScriptToEvaluateOnLoad({scriptSource: `(${listenForCompletionEvent.toString()})()`});

      if (!!config['debug']) {
        Console.messageAdded((event) => {
          console.log(`[${event.message.level}] ${event.message.text}`);
        });
      }

      // 【修正】実際に接続した相手の IP アドレスを応答ごとに検査する。
      // 公開ホストからのリダイレクト、ページ内の JavaScript による遷移や iframe、
      // DNS リバインディングで内部アドレスに接続した場合も、その内容を利用者に返さない。
      let blocked = false;
      const checkRemoteAddress = (response) => {
        if (config['allowPrivateNetwork'] || !response || !response.remoteIPAddress)
          return;
        if (isPrivateAddress(response.remoteIPAddress)) {
          blocked = true;
          reject(new Error(PRIVATE_ADDRESS_MESSAGE));
        }
      };

      // 【修正2】サイト分離で別プロセスになった cross-site の iframe（OOPIF）や Dedicated Worker の
      // 通信は、このページのセッションには Network イベントが届かない。そのままでは、OOPIF の中の
      // iframe・fetch や Worker の fetch で内部アドレスに接続しても checkRemoteAddress が呼ばれず、
      // その内容が /render の HTML や /screenshot の画像で漏れる。
      // そこで子ターゲットに自動でアタッチし（孫以下にも同じ設定をする）、各セッションで Network を
      // 有効にする。子セッションの Network イベントも、同じ接続の下のハンドラ（下の
      // Network.requestWillBeSent / Network.responseReceived）に届くので、同じ検査がかかる。
      // 監視を始められなかった子ターゲットがあれば、一時停止させたまま内容を返さない（fail closed）。
      if (!config['allowPrivateNetwork']) {
        Target.attachedToTarget(async(event) => {
          const sessionId = event.sessionId;
          try {
            await client.send('Network.enable', {}, sessionId);
            await client.send('Target.setAutoAttach', AUTO_ATTACH_PARAMS, sessionId);
          } catch (error) {
            blocked = true;
            reject(new Error(UNMONITORED_TARGET_MESSAGE));
            return;
          }
          client.send('Runtime.runIfWaitingForDebugger', {}, sessionId).catch(() => {});
        });
        try {
          await Target.setAutoAttach(AUTO_ATTACH_PARAMS);
        } catch (error) {
          reject(new Error(UNMONITORED_TARGET_MESSAGE));
          return;
        }
      }

      // 【修正2】WebSocket には同一オリジンポリシー（CORS）がかからず、ページの JavaScript が
      // ws://127.0.0.1:... などの内部サービスから受け取った内容を DOM に書けば、/render で返ってしまう。
      // WebSocket の CDP イベントには接続先の IP が無いので、作られた時点で URL のホストを検査する
      // （子ターゲットの WebSocket も同じハンドラに届く）。DNS を引く検査は非同期なので、
      // 実行中の検査を pendingChecks に入れ、内容を返す前の checkBlocked で終わるのを待つ。
      const pendingChecks = new Set();
      Network.webSocketCreated((event) => {
        if (config['allowPrivateNetwork'])
          return;
        const check = isPrivateWebSocketUrl(event.url).then((isPrivate) => {
          if (isPrivate) {
            blocked = true;
            reject(new Error(PRIVATE_ADDRESS_MESSAGE));
          }
          pendingChecks.delete(check);
        });
        pendingChecks.add(check);
      });

      Page.navigate({url: url}).catch(reject);

      // Check that all outstanding network requests have finished loading.
      const outstandingRequests = new Map();
      let initialRequestId = undefined;
      Network.requestWillBeSent((event) => {
        // 【修正】リダイレクト元の応答も検査する
        checkRemoteAddress(event.redirectResponse);
        if (!initialRequestId)
          initialRequestId = event.requestId;
        outstandingRequests.set(event.requestId, event);
      });

      let statusCode = 200;
      Network.responseReceived((event) => {
        // 【修正】すべての応答（メイン文書・サブリソース）の接続先を検査する
        checkRemoteAddress(event.response);
        if (event.requestId == initialRequestId && event.response.status != 0)
          statusCode = event.response.status;
      });

      Network.loadingFinished((event) => {
        outstandingRequests.delete(event.requestId);
      });

      Network.loadingFailed((event) => {
        if (event.requestId == initialRequestId) {
          reject({message: event.errorText});
        }
        outstandingRequests.delete(event.requestId);
      });

      // Ensure the page load event has fired.
      let pageLoadEventFired = false;
      Page.loadEventFired(() => {
        pageLoadEventFired = true;
      });

      // Set a virtual time budget of 10 seconds. This 10 second timer is paused while there are
      // any active network requests. This allows for a maximum of 10 seconds in script/rendering
      // time. Once the page is idle, the virtual time budget expires immediately.
      let currentTimeBudget = 10000;
      Emulation.setVirtualTimePolicy({policy: 'pauseIfNetworkFetchesPending', budget: currentTimeBudget});

      let budgetExpired = async() => {
        let result = await Runtime.evaluate({expression: `(${getStatusCode.toString()})()`});
        // Original status codes which aren't either 200 or 304 always return with that
        // status code, regardless of meta tags.
        if ((statusCode == 200 || statusCode == 304) && result.result.value)
          statusCode = result.result.value;

        resolve({
          status: statusCode || 200,
          // 【修正】読み込み完了の後（内容の取り出し直前）にも、内部アドレスへの
          // 接続がなかったかを呼び出し側で確認できるようにする
          // 【修正2】WebSocket の接続先の検査（非同期）が終わるのを待ってから判定する
          checkBlocked: async() => {
            await Promise.all(Array.from(pendingChecks));
            if (blocked)
              throw new Error(PRIVATE_ADDRESS_MESSAGE);
          },
        });
        budgetExpired = () => {};
        clearTimeout(timeoutId);
      };

      Emulation.virtualTimeBudgetExpired((event) => {
        // Reset the virtual time budget if there is still outstanding work. Converge the virtual time
        // budget just in case network requests are firing on a regular timer.
        if (outstandingRequests.size || !pageLoadEventFired) {
          // Budget must be an integer.
          currentTimeBudget = Math.ceil(currentTimeBudget / 2);
          Emulation.setVirtualTimePolicy({policy: 'pauseIfNetworkFetchesPending', budget: currentTimeBudget});
          return;
        }
        budgetExpired();
      });

      // Set a hard limit of 10 seconds.
      let timeoutId = setTimeout(() => {
        console.log(`10 second time budget limit reached.
          Attempted rendering: ${url}
          Page load event fired: ${pageLoadEventFired}
          Outstanding network requests: ${outstandingRequests.size}`);
        budgetExpired();
      }, 10000);

      // Listen for the message that signals that rendering event was fired.
      Console.messageAdded((event) => {
        if (event.message.text === 'Rendering complete') {
          budgetExpired();
        }
      });
    });
  }

  serialize(url, options, config) {
    /**
     * Executed on the page after the page has loaded. Strips script and
     * import tags to prevent further loading of resources.
     */
    function stripPage() {
      const elements = document.querySelectorAll('script, link[rel=import]');
      elements.forEach((e) => e.remove());
    }

    /**
     * Injects a <base> tag which allows other resources to load. This
     * has no effect on serialised output, but allows it to verify render quality.
     * @param {string} url - Requested URL to set as the base.
     */
    function injectBaseHref(url) {
      const base = document.createElement('base');
      base.setAttribute('href', url);
      document.head.appendChild(base);
    }

    return new Promise(async(resolve, reject) => {
      // 【修正】タブを開く前に URL を検査し、以降は正規化した URL だけを使う
      try {
        url = await validateUrl(url, config);
      } catch (error) {
        reject(error);
        return;
      }

      const tab = await CDP.New({port: config.port});
      const client = await CDP({tab: tab, port: config.port});

      const {Runtime} = client;

      try {
        let renderResult = await this._loadPage(client, url, options, config);

        await Runtime.evaluate({expression: `(${stripPage.toString()})()`});
        // 【修正】URL を JSON 文字列リテラルとして埋め込む（' を含む URL で式が壊れる・注入されるのを防ぐ）
        await Runtime.evaluate({expression: `(${injectBaseHref.toString()})(${JSON.stringify(url)})`});

        let result = await Runtime.evaluate({expression: 'document.firstElementChild.outerHTML'});
        CDP.Close({id: client.target.id, port: config.port});
        // 【修正】内容を返す直前に、内部アドレスへの接続がなかったか再確認する
        // 【修正2】checkBlocked は非同期になったので await する
        await renderResult.checkBlocked();
        resolve({
          status: renderResult.status,
          body: result.result.value});
      } catch (error) {
        reject(error);
      }
    });
  }

  captureScreenshot(url, options, config) {
    return new Promise(async(resolve, reject) => {
      // 【修正】タブを開く前に URL を検査し、以降は正規化した URL だけを使う
      try {
        url = await validateUrl(url, config);
      } catch (error) {
        reject(error);
        return;
      }

      const tab = await CDP.New({port: config.port});
      const client = await CDP({tab: tab, port: config.port});

      const {Animation, Page, Emulation} = client;

      // Accelerate global animation timeline so that loading animations
      // are hopefully complete by the time we take the screenshot.
      Animation.setPlaybackRate({playbackRate: 1000});

      const width = Math.min(2000, parseInt(options['width']) || 1000);
      const height = Math.min(2000, parseInt(options['height']) || 1000);
      await Emulation.setDeviceMetricsOverride({width: width, height: height, mobile: true, deviceScaleFactor: 3.5, fitWindow: false, screenWidth: width, screenHeight: height});
      await Emulation.setVisibleSize({width: width, height: height});

      try {
        // 【修正】結果を受け取り、撮影後に内部アドレスへの接続がなかったか確認する
        let renderResult = await this._loadPage(client, url, options, config);
        let {data} = await Page.captureScreenshot({format: 'jpeg', quality: 60});

        CDP.Close({id: client.target.id, port: config.port});
        // 【修正2】checkBlocked は非同期になったので await する
        await renderResult.checkBlocked();
        resolve(data);
      } catch (error) {
        reject(error);
      }
    });
  }
}

module.exports = new Renderer();
