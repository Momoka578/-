import java.io.*;
import java.util.logging.Logger;
import java.util.regex.Pattern; // 【修正】ログ用の無害化パターンのために追加
import javax.servlet.*;
import javax.servlet.http.*;

public class Target100 extends HttpServlet
{
    // 【修正】ログへ書く前に置き換える文字の集合。
    //   \p{Cc}: 制御文字すべて（CR, LF, TAB, ESC, NUL, DEL, C1 制御文字 U+0080〜U+009F〔NEL U+0085 を含む〕）
    //   \p{Zl}: 行区切り（LINE SEPARATOR U+2028）
    //   \p{Zp}: 段落区切り（PARAGRAPH SEPARATOR U+2029）
    //   \p{Cf}: 書式制御文字（RLO U+202E などの双方向制御、ゼロ幅文字など。見た目の偽装を防ぐ）
    // 元のコードは LF（\n）だけを置き換えていたため、CR などで偽のログ行や表示の上書きができた。
    private static final Pattern LOG_UNSAFE_CHARS =
        Pattern.compile("[\\p{Cc}\\p{Zl}\\p{Zp}\\p{Cf}]");

    public void doGet(HttpServletRequest req, HttpServletResponse res)
    	throws ServletException, IOException
    {
        res.setContentType("text/html");
        ServletOutputStream out = res.getOutputStream();
		ServletContext sctx = getServletContext();
        out.println("<HTML><HEAD><TITLE>Test</TITLE></HEAD><BODY><blockquote><pre>");

		String cmd = req.getParameter("cmd");
		if(cmd != null) {
			// 【修正】== は参照の比較になるため、equals で文字列の内容を比較する（CWE-597）
			if("valid".equals(cmd))
				out.println("good");
			else
				// 【修正】LF だけでなく、CR・NEL・U+2028/U+2029 などの行区切りと制御文字・書式制御文字を
				//         すべて "_" に置き換えてからログへ書き込む（CWE-117）
				sctx.log("invalid command: " + LOG_UNSAFE_CHARS.matcher(cmd).replaceAll("_"));
		} else {
			out.println("specify a command");
		}

        out.println("</pre></blockquote></BODY></HTML>");
        out.close();
    }
}
