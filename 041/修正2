          , hostname: '192.168.33.1'
        }
      };
    } else {
      cmd = {
          type: "Linux"
        , pkg: "notify-send"
        , msg: ''
        // 【修正】execFile では配列の 1 要素が 1 つの引数になるので、'-t 0' を 2 つの引数に分けて持つ。
        , sticky: ['-t', '0']
        , icon: '-i'
        , priority: {
