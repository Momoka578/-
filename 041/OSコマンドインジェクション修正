/**
 * Module dependencies.
 */

// 【修正】exec は /bin/sh -c（Windows では cmd.exe）を経由してシェルのメタ文字を解釈するため、
//        シェルを経由せずにコマンド名と引数の配列を渡す execFile に置き換えた。
var execFile = require('child_process').execFile
  , fs = require('fs')
  , path = require('path')
  , exists = fs.existsSync || path.existsSync
  , os = require('os')
  // 【修正】quote = JSON.stringify は削除した。ダブルクォートで囲むだけで $(...) や `...` を防げず、
