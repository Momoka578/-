/**
 * Expose `growl`.
 */

exports = module.exports = growl;

/**
 * Node-growl version.
 */

exports.version = '1.4.1'

/**
 * Send growl notification _msg_ with _options_.
 *
 * Options:
 *
 *  - title   Notification title
 *  - sticky  Make the notification stick (defaults to false)
 *  - priority  Specify an int or named key (default is 0)
 *  - name    Application name (defaults to growlnotify)
 *  - sound   Sound efect ( in OSx defined in preferences -> sound -> effects) * works only in OSX > 10.8x
 *  - image
 *    - path to an icon sets --iconpath
 *    - path to an image sets --image
 *    - capitalized word sets --appIcon
 *    - filename uses extname as --icon
 *    - otherwise treated as --icon
 *
 * Examples:
 *
 *   growl('New email')
 *   growl('5 new emails', { title: 'Thunderbird' })
 *   growl('5 new emails', { title: 'Thunderbird', sound: 'Purr' })
 *   growl('Email sent', function(){
 *     // ... notification sent
 *   })
 *
 * @param {string} msg
 * @param {object} options
 * @param {function} fn
 * @api public
 */

function growl(msg, options, fn) {
  var image
    , args
    , options = options || {}
    , fn = fn || function(){};

  if (options.exec) {
    cmd = {
        type: "Custom"
      , pkg: options.exec
      , range: []
    };
  }

  // noop
  if (!cmd) return fn(new Error('growl not supported on this platform'));
  args = [cmd.pkg];

  // image
  // 【修正】image は quote() で囲まず、そのまま 1 つの引数として渡す（この switch 内すべて）。
  if (image = options.image) {
    switch(cmd.type) {
      case 'Darwin-Growl':
        var flag, ext = path.extname(image).substr(1)
        flag = flag || ext == 'icns' && 'iconpath'
        flag = flag || /^[A-Z]/.test(image) && 'appIcon'
        flag = flag || /^png|gif|jpe?g$/.test(ext) && 'image'
        flag = flag || ext && (image = ext) && 'icon'
        flag = flag || 'icon'
        args.push('--' + flag, image)
        break;
      case 'Darwin-NotificationCenter':
        args.push(cmd.icon, image);
        break;
      case 'Linux':
        args.push(cmd.icon, image);
        // libnotify defaults to sticky, set a hint for transient notifications
        if (!options.sticky) args.push('--hint=int:transient:1');
        break;
      case 'Windows':
        args.push(cmd.icon + image);
        break;
    }
  }

  // sticky
  // 【修正】sticky のオプションがない種類（cmd.sticky が undefined）では引数を足さない
  //        （execFile では undefined が "undefined" という引数になってしまうため）。
  //        Linux の ['-t', '0'] のような配列は別々の引数として足す。
  if (options.sticky && cmd.sticky) args.push.apply(args, [].concat(cmd.sticky));

  // priority
  if (options.priority) {
    var priority = options.priority + '';
    var checkindexOf = cmd.priority.range.indexOf(priority);
    if (~cmd.priority.range.indexOf(priority)) {
      // 【修正】照合に使った文字列 priority をそのまま渡す（options.priority を渡すと、照合後に
      //        別の値へ文字列化されるオブジェクトを渡されうるため）。また、オブジェクトの
      //        cmd.priority ではなく、オプション名の cmd.priority.cmd を渡す。
      args.push(cmd.priority.cmd, priority);
    }
  }

  //sound
  // 【修正】sound は文字列で、'-' で始まらない場合だけ渡す。
  if(options.sound && cmd.type === 'Darwin-NotificationCenter' && isSafeOptionValue(options.sound)){
    args.push(cmd.sound, options.sound)
  }

  // name
  // 【修正】name も sound と同じく、文字列で '-' で始まらない場合だけ渡す。
  if (options.name && cmd.type === "Darwin-Growl" && isSafeOptionValue(options.name)) {
    args.push('--name', options.name);
  }

  // 【修正】以下の switch では quote() とその後の改行の置換をやめ、msg・title・subtitle・url を
  //        文字列のまま 1 つずつの引数として渡す（シェルを通らないので改行もそのまま保たれる）。
  switch(cmd.type) {
    case 'Darwin-Growl':
      args.push(cmd.msg);
      args.push(String(msg));
      if (options.title) args.push(String(options.title));
      break;
    case 'Darwin-NotificationCenter':
      args.push(cmd.msg);
      args.push(String(msg));
      if (options.title) {
        args.push(cmd.title);
        args.push(String(options.title));
      }
      if (options.subtitle) {
        args.push(cmd.subtitle);
        args.push(String(options.subtitle));
      }
      if (options.url) {
        args.push(cmd.url);
        args.push(String(options.url));
      }
      break;
    case 'Linux-Growl':
      args.push(cmd.msg);
      args.push(String(msg));
      if (options.title) args.push(String(options.title));
      if (cmd.host) {
        args.push(cmd.host.cmd, cmd.host.hostname)
      }
      break;
    case 'Linux':
      // 【修正】title や msg が '-' で始まっても notify-send のオプションとして解釈されないよう、
      //        '--' でオプションの終わりを示してから渡す。
      args.push('--');
      if (options.title) {
        args.push(String(options.title));
        // 【修正】cmd.msg は空文字で、execFile では空の引数になってしまうため渡さない。
        args.push(String(msg));
      } else {
        args.push(String(msg));
      }
      break;
    case 'Windows':
      args.push(String(msg));
      if (options.title) args.push(cmd.title + options.title);
      if (options.url) args.push(cmd.url + options.url);
      break;
    case 'Custom':
      // 【修正】options.exec のコマンド文字列を空白で区切ってコマンド名と引数に分け、message は
      //        シェルを通さずに引数として渡す。%s を含む引数には message を埋め込み（replace には関数を渡し、
      //        message 内の $& や $1 などが置換パターンとして解釈されないようにする）、%s がなければ
      //        最後の引数として足す。
      (function(origCommand) {
        var message = String(options.title
          ? options.title + ': ' + msg
          : msg);
        var replaced = false;
        var parts = String(origCommand).trim().split(/\s+/).map(function(part) {
          return part.replace(/(^|[^%])%s/g, function(all, before) {
            replaced = true;
            return before + message;
          });
        });
        args = parts.concat(args.slice(1));
        if (!replaced) args.push(message);
      })(args[0]);
      break;
  }

  // execute
  // 【修正】args.join(' ') を exec でシェルに渡すのをやめ、execFile でコマンド名と引数の配列を直接渡す。
  //        引数はシェルに解釈されないので、$(...)・`...`・$VAR・;・| などを含んでいてもコマンドは実行されない。
  execFile(String(args[0]), args.slice(1).map(String), fn);
};
