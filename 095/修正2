	// 追加: HTML の特殊文字をエスケープするヘルパー（credit/caption を innerHTML に入れる前に使う）
	_escapeHTML: function(str) {
		return String(str)
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/"/g, "&quot;")
			.replace(/'/g, "&#39;");
	},

	// 【修正2】autolink 用: エスケープと linkify を、linkify の URL パターンが文字参照を取り込まない順で行う。
	// 1) 入力の < > " ' を私用領域の文字 U+E000〜U+E003 に置き換える（入力に元から U+E000〜U+E003 があれば U+FFFD にする）。
	//    これらは linkify の URL の文字クラスに含まれず、単語文字でもないので、元の < > " ' と同じ所で URL が切れる。
	// 2) linkify する。linkify が作るタグ（<a class='tl-makelink' href='...' onclick='void(0)'>...</a>）には & が含まれない。
	// 3) 残っている & はすべて入力由来なので &amp; にし、仮の文字を &lt; &gt; &quot; &#39; に戻す。
	// 入力由来の < > " ' は linkify の処理中に文字として存在しないので、linkify が作る属性の引用符を閉じることはできない。
	_linkifyEscaped: function(str) {
		var s = String(str)
			.replace(/[\uE000-\uE003]/g, "\uFFFD")
			.replace(/</g, "\uE000")
			.replace(/>/g, "\uE001")
			.replace(/"/g, "\uE002")
			.replace(/'/g, "\uE003");
		s = TL.Util.linkify(s);
		return s
			.replace(/&/g, "&amp;")
			.replace(/\uE000/g, "&lt;")
			.replace(/\uE001/g, "&gt;")
			.replace(/\uE002/g, "&quot;")
			.replace(/\uE003/g, "&#39;");
	},

	// 【修正2】HTML 文字列を許可リスト方式で無害化して、el の中身にする（credit_alternate 用）。
	// - document.implementation.createHTMLDocument で作った、表示しない文書（スクリプトが動かず、画像も読み込まれない）で解析する。
	// - 解析した要素はそのまま移さず、表示中の文書で作り直す（_appendSafeNodes）。HTML 文字列に戻して innerHTML に入れ直すことはしない。
	// - createHTMLDocument がない環境では、無害化できないので、これまでどおりエスケープして文字として出力する。
	_setSanitizedHTML: function(el, html) {
		if (!(document.implementation && document.implementation.createHTMLDocument)) {
			el.innerHTML = this._escapeHTML(html);
			return;
		}
		var doc = document.implementation.createHTMLDocument("");
		var tmp = doc.createElement("div");
		tmp.innerHTML = String(html);
		el.innerHTML = "";
		this._appendSafeNodes(tmp, el);
	},

	// 【修正2】from の子孫のうち、テキストと a 要素だけを to に作り直して追加する。
	// - a 要素は新しく作り、href は _isSafeLink() を通るものだけ、target は "_blank" だけを付け直す。on* などほかの属性は捨てる。
	// - script/style などの要素は中身ごと捨て、それ以外の要素はタグだけ外して中身を残す。コメントなどは捨てる。
	_appendSafeNodes: function(from, to) {
		var node, tag, a, href;
		for (node = from.firstChild; node; node = node.nextSibling) {
			if (node.nodeType === 3) {
				to.appendChild(document.createTextNode(node.nodeValue));
			} else if (node.nodeType === 1) {
				tag = node.nodeName.toLowerCase();
				if (tag === "a") {
					a = document.createElement("a");
					href = node.getAttribute("href");
					if (href && this._isSafeLink(href)) {
						a.setAttribute("href", href);
						if (node.getAttribute("target") === "_blank") {
							a.setAttribute("target", "_blank");
						}
					}
					this._appendSafeNodes(node, a);
					to.appendChild(a);
				} else if (!/^(script|style|template|noscript|noembed|noframes|iframe|object|embed|textarea|title|xmp|select|svg|math)$/.test(tag)) {
					this._appendSafeNodes(node, to);
				}
			}
		}
	},

	// 【修正2】リンク先として安全か（http/https/mailto と相対 URL だけを許可）。判定方法は _initLayout の data.link の判定と同じ
	// （ブラウザは URL 中の空白・タブ・改行・制御文字を除去して解釈するため、それらを取り除いてから判定する）。
	_isSafeLink: function(url) {
		var link_check = String(url).replace(/[\u0000- ]/g, "");
		return !(/^[a-z][a-z0-9+.\-]*:/i.test(link_check) && !/^(https?|mailto):/i.test(link_check));
	},

	_initLayout: function () {

		// Message
		this.message = new TL.Message({}, this.options);
		this.message.addTo(this._el.container);

		// Create Layout
		this._el.content_container = TL.Dom.create("div", "tl-media-content-container", this._el.container);

		// Link
		// 修正: javascript: などの危険なスキームのリンクを作らないよう、http/https/mailto と相対 URL だけを許可する
		// （ブラウザは URL 中の空白・タブ・改行・制御文字を除去して解釈するため、それらを取り除いてから判定する）
		if (this.data.link && this.data.link != "") {
			var link_check = String(this.data.link).replace(/[\u0000- ]/g, "");
			if (/^[a-z][a-z0-9+.\-]*:/i.test(link_check) && !/^(https?|mailto):/i.test(link_check)) {
				trace("Ignoring media link with disallowed scheme: " + this.data.link);
				this.data.link = null;
			}
		}
		if (this.data.link && this.data.link != "") {

			this._el.link = TL.Dom.create("a", "tl-media-link", this._el.content_container);
			this._el.link.href = this.data.link;
			if (this.data.link_target && this.data.link_target != "") {
				this._el.link.target = this.data.link_target;
			} else {
				this._el.link.target = "_blank";
			}

			this._el.content = TL.Dom.create("div", "tl-media-content", this._el.link);

		} else {
			this._el.content = TL.Dom.create("div", "tl-media-content", this._el.content_container);
		}


	},

	// Update Display
	_updateDisplay: function(w, h, l) {
		if (w) {
			this.options.width = w;

		}
		//this._el.container.style.width = this.options.width + "px";
		if (h) {
			this.options.height = h;
		}

		if (l) {
			this.options.layout = l;
		}

		if (this._el.credit) {
			this.options.credit_height 		= this._el.credit.offsetHeight;
		}
		if (this._el.caption) {
			this.options.caption_height 	= this._el.caption.offsetHeight + 5;
		}

		this.updateMediaDisplay(this.options.layout);

	},

	_stopMedia: function() {

	}

});
