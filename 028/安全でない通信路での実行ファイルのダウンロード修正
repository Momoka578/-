```javascript
'use strict'

const nugget = require('nugget')
// 【修正】ダウンロードしたインストーラの完全性検証（URL 検査・SHA-256・Authenticode 署名）に使うモジュール
const fs = require('fs')
const path = require('path')
const url = require('url')
const crypto = require('crypto')
const childProcess = require('child_process')

const utils = require('./utils')
// 【修正】インストーラごとの検証情報（期待する署名者・SHA-256）を constants から参照する
const constants = require('./constants')

/**
 * Downloads the Visual Studio C++ Build Tools and Python installer to a temporary folder
 * at %USERPROFILE%\.windows-build-tools
 *
 * @returns {Promise} - Promise
 */
function download (cb) {
  // 【修正】各インストーラに対応する検証情報を渡す
  downloadTools(utils.getBuildToolsInstallerPath(), constants.buildTools)
    .then(() => downloadTools(utils.getPythonInstallerPath(), constants.python))
    .then(() => cb())
    .catch((error) => console.log(error))
}

/**
 * Downloads specified file with a url from the installer.
 *
 * @param installer            - An object with fileName, directory, url,
 *                                  and destination path of the file to be downloaded
 * @param expected             - An object with the expected signer and (optional) sha256
 * @returns {Promise.<string>} - Promise resolving with the path to the downloaded file
 */
function downloadTools (installer, expected) {
  return new Promise((resolve, reject) => {
    // 【修正】暗号化されていない http などの URL（ミラー指定を含む）からは実行ファイルを取得しない
    const protocol = url.parse(installer.url).protocol
    if (protocol !== 'https:') {
      return reject(new Error(`Refusing to download ${installer.fileName} over an insecure connection (${installer.url}). Please use an https:// URL.`))
    }

    const nuggetOptions = {
      target: installer.fileName,
      dir: installer.directory,
      resume: true,
      verbose: true,
      // 【修正】サーバ証明書の検証を有効にする（false だと中間者が偽の証明書で通信を差し替えられる）
      strictSSL: true,
      proxy: process.env.PROXY || undefined
    }

    nugget(installer.url, nuggetOptions, (errors) => {
      if (errors) {
        // nugget returns an array of errors but we only need 1st because we only have 1 url
        const error = errors[0]

        if (error.message.indexOf('404') === -1) {
          return reject(error)
        } else {
          return reject(`Could not find ${installer.fileName} at ${installer.url}`)
        }
      }

      // 【修正】保存しただけで resolve せず、完全性を検証してから resolve する
      verifyInstaller(installer.path, expected)
        .then(() => {
          console.log(`Downloaded ${installer.fileName}. Saved to ${installer.path}.`)
          resolve(installer.path)
        })
        .catch((error) => {
          // 【修正】検証に失敗したファイルは後で実行されないように削除してから reject する
          fs.unlink(installer.path, () => reject(error))
        })
    })
  })
}

/**
 * 【修正】ダウンロードしたインストーラの完全性を検証する。
 * - 期待する SHA-256 が設定されていれば、ハッシュの一致を必須とする。
 * - 設定されていなければ、Authenticode 署名が有効で、署名者が期待どおりであることを必須とする。
 * どちらも確認できない場合は失敗とする（fail closed）。
 *
 * @param filePath           - Path to the downloaded installer
 * @param expected           - An object with the expected signer and (optional) sha256
 * @returns {Promise}        - Resolves if the installer could be verified
 */
function verifyInstaller (filePath, expected) {
  const expectedHash = (expected && expected.sha256) ? String(expected.sha256).trim().toLowerCase() : ''

  return computeSha256(filePath).then((actualHash) => {
    if (expectedHash) {
      if (actualHash !== expectedHash) {
        throw new Error(`SHA-256 mismatch for ${filePath}: expected ${expectedHash}, got ${actualHash}`)
      }
      return
    }

    return verifyAuthenticode(filePath, expected && expected.signer)
  })
}

/**
 * 【修正】ファイルの SHA-256 を計算する
 *
 * @param filePath           - Path to the file
 * @returns {Promise.<string>} - Resolves with the hex-encoded SHA-256 digest
 */
function computeSha256 (filePath) {
  return new Promise((resolve, reject) => {
    const hash = crypto.createHash('sha256')
    const stream = fs.createReadStream(filePath)

    stream.on('error', reject)
    stream.on('data', (chunk) => hash.update(chunk))
    stream.on('end', () => resolve(hash.digest('hex')))
  })
}

/**
 * 【修正】Windows の Get-AuthenticodeSignature で署名を検証し、
 * 状態が Valid かつ署名者証明書の CN が期待値と一致することを確認する。
 * パスはコマンド文字列に埋め込まず、環境変数で渡す（引用符によるコマンド注入を防ぐ）。
 *
 * @param filePath           - Path to the downloaded installer
 * @param signer             - Expected common name (CN) of the signing certificate
 * @returns {Promise}        - Resolves if the signature is valid and from the expected signer
 */
function verifyAuthenticode (filePath, signer) {
  return new Promise((resolve, reject) => {
    if (!signer) {
      return reject(new Error(`No expected signer configured for ${filePath}. Refusing to use an unverified installer.`))
    }

    if (process.platform !== 'win32') {
      return reject(new Error(`Could not verify the signature of ${filePath}: Authenticode verification requires Windows.`))
    }

    // PATH 上の偽の powershell.exe を使わないよう、システムディレクトリの絶対パスを指定する
    const powershell = path.join(process.env.SystemRoot || 'C:\\Windows', 'System32', 'WindowsPowerShell', 'v1.0', 'powershell.exe')
    const script = [
      '$s = Get-AuthenticodeSignature -LiteralPath $env:WBT_VERIFY_PATH',
      '$subject = ""',
      'if ($s.SignerCertificate) { $subject = $s.SignerCertificate.Subject }',
      'Write-Output ([string]$s.Status)',
      'Write-Output $subject'
    ].join('; ')
    const env = Object.assign({}, process.env, { WBT_VERIFY_PATH: filePath })

    childProcess.execFile(powershell, ['-NoProfile', '-NonInteractive', '-Command', script], { env: env, windowsHide: true }, (error, stdout) => {
      if (error) {
        return reject(new Error(`Could not verify the signature of ${filePath}: ${error.message}`))
      }

      const lines = String(stdout).split(/\r?\n/)
      const status = (lines[0] || '').trim()
      const subject = (lines[1] || '').trim()

      if (status !== 'Valid') {
        return reject(new Error(`Invalid Authenticode signature on ${filePath} (status: ${status || 'unknown'}).`))
      }

      if (!subjectHasCommonName(subject, signer)) {
        return reject(new Error(`Unexpected signer for ${filePath}: "${subject}" (expected CN=${signer}).`))
      }

      resolve()
    })
  })
}

/**
 * 【修正】証明書の Subject（例: "CN=Microsoft Corporation, O=Microsoft Corporation, ..."）に
 * 指定した CN が完全一致で含まれるかを調べる（部分一致による偽装を防ぐ）
 *
 * @param subject            - Subject of the signing certificate
 * @param commonName         - Expected common name
 * @returns {boolean}
 */
function subjectHasCommonName (subject, commonName) {
  return subject.split(',').some((part) => {
    const trimmed = part.trim()
    return trimmed === `CN=${commonName}` || trimmed === `CN="${commonName}"`
  })
}

module.exports = download
