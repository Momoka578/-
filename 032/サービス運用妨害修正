  reverseProxy.on('error', proxyError);

  // 【修正】クライアントからの入力（req）側の 'error' にもハンドラを付ける
  req.on('error', proxyError);

  //
  // For each data `chunk` received from the incoming
  // `req` write it to the `reverseProxy` request.
  //
