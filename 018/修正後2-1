var postMessageHandler = function(msg) {
  // 【修正】先頭 ^ と末尾 $ で文字列全体の一致にし、"." を \. でエスケープする。
  //         （元の正規表現は前後に何が付いても一致し、"." が任意の 1 文字に一致したため、
  //           https://www.google.com.attacker.example や https://wwwXgoogle.com も通ってしまった）
  //         あわせて、通信路で改ざんされうる http は許可せず https だけにする。
  const originRegExp = /^https:\/\/www\.google\.com$/;
  if (originRegExp.test(msg.origin)) {
    // 【修正】eval(msg.data) → テキストとして表示する（受け取ったデータをコードとして実行しない）。
    var div = document.createElement('div');
    div.textContent = msg.data;
    document.documentElement.appendChild(div);
  }
}

window.addEventListener('message', postMessageHandler, false);
```

