### 修正したコード: sources_postMessage_complexMessageDocumentWriteEval.tmpl

```html
const postMessageHandler = function(msg) {
  // 【修正】送信元オリジンを確認し、自分と同じオリジン以外から届いたメッセージは無視する。
  if (msg.origin !== window.location.origin) {
    return;
  }

  let action = msg.data.action;
  if(action === 'exec') {
    // 【修正】受け取った文字列を eval で実行しない（コードを実行する命令は受け付けない）。
    console.debug('exec is not supported');
  } else if (action === 'addImage') {
    // 【修正】HTML 文字列の連結 + document.write をやめ、img 要素を DOM API で作る。
    //         setAttribute で設定した値は属性値として扱われ、HTML として解釈されないので、
    //         ">" や引用符で別のタグや onerror 属性を足すことはできない（元のコードと同じ href 属性を設定する）。
    const img = document.createElement('img');
    img.setAttribute('href', msg.data.source);
    document.body.appendChild(img);
  } else if (action === 'addHtml') {
    // 【修正】document.write(HTML) → テキストノードとして追加する（HTML として解釈しない）。
    document.body.appendChild(document.createTextNode(msg.data.html));
  } else {
    console.debug('unsupported command');
  }
};

window.addEventListener('message', postMessageHandler, false);
```

### 修正したコード: sources_postMessage_documentWrite.tmpl

```html
var postMessageHandler = function(msg) {
  // 【修正】送信元オリジンを確認し、自分と同じオリジン以外から届いたメッセージは無視する。
  if (msg.origin !== window.location.origin) {
    return;
  }

  var content = JSON.parse(msg.data);
  // 【修正】URL を解析し、自分と同じオリジンのスクリプトだけを読み込む。
  //         javascript: や data: の URL はオリジンが "null" になるので、ここで弾かれる。
  var url = new URL(content.url, window.location.href);
  if (url.origin !== window.location.origin) {
    return;
  }
  // 【修正】文字列連結した HTML を document.write するのをやめる（引用符を閉じてタグや属性を足せたため）。
  //         DOM API で script 要素を作り、src プロパティに URL を設定する。
  var script = document.createElement('script');
  script.src = url.href;
  document.documentElement.appendChild(script);
};

window.addEventListener('message', postMessageHandler, false);
```

### 修正したコード: sources_postMessage_eval.tmpl

```html
var postMessageHandler = function(msg) {
  // 【修正】送信元オリジンを確認し、自分と同じオリジン以外から届いたメッセージは無視する。
  if (msg.origin !== window.location.origin) {
    return;
  }

  var content = msg.data;
  // 【修正】eval(content) → JSON.parse(content)。データとして解析するだけで、コードとして実行しない。
  var msgObj;
  try {
    msgObj = JSON.parse(content);
  } catch (e) {
    return;  // 【修正】JSON として読めないメッセージは無視する。
  }

  // 【修正】JSON.parse の結果が null の場合に備えて msgObj の存在も確認する。
  if (msgObj && msgObj.isActive) {
    document.write("PostMessage arrived!");
  }
}

window.addEventListener('message', postMessageHandler, false);
```

